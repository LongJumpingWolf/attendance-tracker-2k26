{
  "name": "College Tracker",
  "short_name": "Tracker",
  "description": "College Tracker - attendance and deadline tracker",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f2f2f7",
  "theme_color": "#f2f2f7",
  "orientation": "any",
  "permissions": [
    "notifications"
  ],
  "shortcuts": [
    {
      "name": "Mark class present",
      "short_name": "Present",
      "description": "Mark the class that has started as present",
      "url": "/?mark=next",
      "icons": [
        {
          "src": "/icon-adaptive.svg",
          "sizes": "any",
          "type": "image/svg+xml",
          "purpose": "any"
        },
        {
          "src": "/icon-light.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any",
          "media": "(prefers-color-scheme: light)"
        },
        {
          "src": "/icon-dark.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any",
          "media": "(prefers-color-scheme: dark)"
        }
      ]
    },
