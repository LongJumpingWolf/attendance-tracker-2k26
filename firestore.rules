rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Notification schedules: each belongs to the (anonymous) account that saved it.
    // The scheduler reads them with admin credentials, which bypass these rules.
    match /notificationSchedules/{scheduleId} {
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.fcmToken is string
                    && request.resource.data.fcmToken.size() > 0;
      allow read, update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // ---- Friend connections (anonymous auth) ----

    // Public profile: just a display name. Anyone signed in can read it (needed to show who a QR belongs to),
    // only the owner can write it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40;
    }

    // Short-lived magic links. The token is unguessable, so a direct get is allowed; listing is not.
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.expiresAt is timestamp;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Connection requests. An accepted request is a mate connection.
    match /requests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.participants == [request.resource.data.from, request.resource.data.to]
                    && request.resource.data.status == 'pending';
      // Only the person who was asked can accept or decline, and only the status may change
      allow update: if request.auth != null
                    && resource.data.to == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // "Did you mark me present?" The person who was away asks a mate about specific classes.
    // Only accepted mates can send one: the ping names the accepted connection (requestId), and the rules
    // check that it is accepted and that sender and receiver are its two people.
    // Only the mate who was asked can answer, and only the answers (items) and status may change.
    match /pings/{pingId} {
      function acceptedMates() {
        let req = get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data;
        return req.status == 'accepted'
            && request.resource.data.from in req.participants
            && request.resource.data.to in req.participants;
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.participants == [request.resource.data.from, request.resource.data.to]
                    && request.resource.data.requestId is string
                    && acceptedMates()
                    && request.resource.data.status == 'asking'
                    && request.resource.data.date is string
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 12;
      allow update: if request.auth != null
                    && resource.data.to == request.auth.uid
                    && resource.data.status == 'asking'
                    && request.resource.data.status == 'answered'
                    && request.resource.data.items.size() == resource.data.items.size()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'status', 'respondedAt']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Synced data: one document per signed-in account, holding a full backup. Only that account can touch it.
    match /syncs/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rev == 1
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 900000;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rev == resource.data.rev + 1
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 900000;
    }

    // Block everything else by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
