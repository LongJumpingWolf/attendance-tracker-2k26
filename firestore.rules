rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDeveloper() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'adityavw2006@gmail.com';
    }

    // ---- Friend connections (anonymous auth) ----

    // Public profile: just a display name. Anyone signed in can read it (needed to show who a QR belongs to),
    // only the owner can write it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40;
    }

    // Short-lived magic links. The token is unguessable, so a direct get is allowed; listing is not.
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.expiresAt is timestamp;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Connection requests. An accepted request is a mate connection.
    match /requests/{requestId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'participants', 'status', 'createdAt'])
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.participants == [request.resource.data.from, request.resource.data.to]
                    && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
                    && request.resource.data.toName is string && request.resource.data.toName.size() <= 40
                    && request.resource.data.status == 'pending';
      // Only the person who was asked can accept or decline, and only the status may change
      allow update: if request.auth != null
                    && resource.data.to == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // "Did you mark me present?" The person who was away asks a mate about specific classes.
    //
    // The server is the security boundary; nothing here relies on the app hiding a button.
    //  * Only the asker can create a Ping, only to someone they have an ACCEPTED connection with (the Ping names that
    //    connection and the rules read it), for a class day within the last few days, with the classes in the shape the
    //    app writes. The id is chosen by the app (so a retry can't make a second Ping) and must be a plain token.
    //  * createdAt is the server's clock, and a Ping lives for 3 days from it. After that nobody can answer it.
    //  * Only the mate who was asked can answer, only while it is still asking and unexpired, and the ONLY thing that
    //    may change is each class's `answer` (yes / no). Who asked, which classes, which day: all frozen.
    //  * The asker then takes a short LEASE on the answer (claimedBy / claimedAt), applies it on their device, and only
    //    then marks it processed. So a Ping is never "processed" before its result is safely applied, and two devices
    //    can't both hold the lease. Processed is final.
    //  * An answered Ping can't be deleted until it is processed, so a result can't be thrown away before it is applied.
    match /pings/{pingId} {
      function signedIn() { return request.auth != null; }
      // Direct in-app Pings require a durable Google/other non-anonymous identity. Anonymous accounts may still
      // create one-time WhatsApp sharePings, but cannot create, answer, lease, or finalize direct Pings.
      function nonAnonymous() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function validId() { return pingId.matches('^[A-Za-z0-9_-]{8,64}$'); }

      // The connection the Ping names: accepted, and made of exactly these two people
      function connected(d) {
        let req = get(/databases/$(database)/documents/requests/$(d.requestId)).data;
        return req.status == 'accepted'
            && req.participants.size() == 2
            && d.from in req.participants
            && d.to in req.participants;
      }

      // One class as the asker writes it: an unanswered question, with only the fields the app uses.
      // (Kept short, and a Ping holds at most 8 classes, on purpose: every class is checked, and Firestore evaluates at most
      // 1,000 expressions per request. 10 classes already reach that limit; tests/rules/pings.test.ts keeps us clear of it.)
      function newItem(i) {
        let items = request.resource.data.items;
        return items.size() <= i
            || (items[i].keys().hasOnly(['key', 'subjectId', 'name', 't', 'substituted', 'answer'])
                && items[i].answer == null
                && items[i].key is string
                && items[i].subjectId is string
                && (!('t' in items[i]) || items[i].t is string)
                && (!('substituted' in items[i]) || items[i].substituted is bool)
                && items[i].name is string && items[i].name.size() <= 60);
      }

      // One class when it is answered: identical to what was asked, except the answer
      function answeredItem(i) {
        let now = request.resource.data.items;
        let was = resource.data.items;
        return now.size() <= i
            || (now[i].diff(was[i]).affectedKeys().hasOnly(['answer']) && now[i].answer in ['yes', 'no']);
      }

      // 3 days from the moment the server created it
      function lifetimeEnds() { return resource.data.createdAt + duration.value(3, 'd'); }

      // The class day has to be recent: not older than the Ping's lifetime, not more than a day ahead (time zones)
      function dayIsRecent(day) {
        let at = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
        return at >= request.time - duration.value(3, 'd') && at <= request.time + duration.value(1, 'd');
      }

      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if nonAnonymous()
                    && validId()
                    && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'participants', 'requestId', 'date', 'items', 'status', 'createdAt'])
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.participants == [request.resource.data.from, request.resource.data.to]
                    && request.resource.data.requestId is string
                    && connected(request.resource.data)
                    && request.resource.data.status == 'asking'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
                    && request.resource.data.toName is string && request.resource.data.toName.size() <= 40
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && dayIsRecent(request.resource.data.date)
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 8
                    && newItem(0) && newItem(1) && newItem(2) && newItem(3) && newItem(4) && newItem(5) && newItem(6) && newItem(7);

      // The mate answers: yes / no on each class, nothing else
      allow update: if nonAnonymous()
                    && resource.data.to == request.auth.uid
                    && resource.data.status == 'asking'
                    && request.time < lifetimeEnds()
                    && resource.data.createdAt <= request.time
                    && resource.data.items.size() <= 8
                    && connected(resource.data)
                    && request.resource.data.status == 'answered'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'status', 'respondedAt'])
                    && request.resource.data.respondedAt == request.time
                    && request.resource.data.items.size() == resource.data.items.size()
                    && answeredItem(0) && answeredItem(1) && answeredItem(2) && answeredItem(3) && answeredItem(4) && answeredItem(5) && answeredItem(6) && answeredItem(7);

      // The asker takes (or renews) the lease on an answer. Free, their own, or run out (2 minutes, by the server's clock).
      allow update: if nonAnonymous()
                    && resource.data.from == request.auth.uid
                    && resource.data.status == 'answered'
                    && request.resource.data.status == 'answered'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
                    && request.resource.data.claimedBy is string
                    && request.resource.data.claimedBy.matches('^[A-Za-z0-9_-]{8,64}$')
                    && request.resource.data.claimedAt == request.time
                    && (resource.data.get('claimedAt', null) == null
                        || resource.data.get('claimedBy', '') == request.resource.data.claimedBy
                        || resource.data.claimedAt + duration.value(2, 'm') <= request.time);

      // The asker finishes: the answer has been applied, so it is processed, for good
      allow update: if nonAnonymous()
                    && resource.data.from == request.auth.uid
                    && resource.data.status == 'answered'
                    && request.resource.data.status == 'processed'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt'])
                    && request.resource.data.processedAt == request.time;

      // Either person can withdraw or clear a Ping, except an answer that hasn't been applied yet
      allow delete: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && resource.data.status != 'answered';
    }

    // Share-link Pings. The document ID is a cryptographically random 256-bit bearer capability.
    // There is no SQL migration or callable Cloud Function: clients can GET only the exact unguessable link ID,
    // and can submit one Yes/No answer before expiresAt. Listing is always owner-only. A random link is a secret;
    // recipients should share it only with the person being asked. Owner answers remain until processed/retention expiry.
    match /sharePings/{pingId} {
      function validId() { return pingId.matches('^[a-f0-9]{64}$'); }
      function owner() { return request.auth != null && request.auth.uid == resource.data.ownerUid; }
      function validShareDay(day) {
        let at = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
        return at >= request.time - duration.value(3, 'd') && at <= request.time + duration.value(1, 'd');
      }
      function newShareItem(i) {
        let items = request.resource.data.items;
        return items.size() <= i
          || (items[i].keys().hasOnly(['key', 'subjectId', 'name', 't', 'substituted', 'answer'])
              && items[i].answer == null
              && items[i].key is string && items[i].key.size() > 0 && items[i].key.size() <= 120
              && items[i].subjectId is string && items[i].subjectId.size() > 0 && items[i].subjectId.size() <= 128
              && (!('t' in items[i]) || items[i].t is string)
              && (!('substituted' in items[i]) || items[i].substituted is bool)
              && items[i].name is string && items[i].name.size() > 0 && items[i].name.size() <= 60);
      }
      function answeredShareItem(i) {
        let nowItems = request.resource.data.items;
        let oldItems = resource.data.items;
        return nowItems.size() <= i
          || (nowItems[i].diff(oldItems[i]).affectedKeys().hasOnly(['answer'])
              && nowItems[i].answer in ['yes', 'no']);
      }

      // Owner may always read their own records. A recipient may GET one known unguessable ID,
      // but cannot list the collection or read expired/cancelled link contents.
      allow get: if validId() && (owner()
                    || (resource.data.status in ['asking', 'answered', 'processed']
                        && request.time < resource.data.purgeAt
                        && (resource.data.status != 'asking' || request.time < resource.data.expiresAt)));
      allow list: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
                    && validId()
                    && request.resource.data.keys().hasOnly(['ownerUid', 'fromName', 'recipientName', 'date', 'items', 'status', 'createdAt', 'expiresAt', 'purgeAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.fromName is string && request.resource.data.fromName.size() > 0 && request.resource.data.fromName.size() <= 40
                    && request.resource.data.recipientName is string && request.resource.data.recipientName.size() <= 40
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && validShareDay(request.resource.data.date)
                    && request.resource.data.status == 'asking'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(1, 'd') + duration.value(2, 'm')
                    && request.resource.data.purgeAt is timestamp
                    && request.resource.data.purgeAt > request.resource.data.expiresAt
                    && request.resource.data.purgeAt <= request.time + duration.value(32, 'd')
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 8
                    && newShareItem(0) && newShareItem(1) && newShareItem(2) && newShareItem(3)
                    && newShareItem(4) && newShareItem(5) && newShareItem(6) && newShareItem(7);

      // Public bearer link: answer exactly once, only before expiry, without changing the sender or class details.
      allow update: if validId()
                    && resource.data.status == 'asking'
                    && request.time < resource.data.expiresAt
                    && request.time < resource.data.purgeAt
                    && request.resource.data.status == 'answered'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'status', 'respondedAt'])
                    && request.resource.data.respondedAt == request.time
                    && request.resource.data.items.size() == resource.data.items.size()
                    && resource.data.items.size() > 0 && resource.data.items.size() <= 8
                    && answeredShareItem(0) && answeredShareItem(1) && answeredShareItem(2) && answeredShareItem(3)
                    && answeredShareItem(4) && answeredShareItem(5) && answeredShareItem(6) && answeredShareItem(7);

      // Owner can withdraw an unresponded link.
      allow update: if owner()
                    && resource.data.status == 'asking'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Owner takes the same short lease used by connected Pings before applying the result locally.
      allow update: if owner()
                    && resource.data.status == 'answered'
                    && request.resource.data.status == 'answered'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
                    && request.resource.data.claimedBy is string
                    && request.resource.data.claimedBy.matches('^[A-Za-z0-9_-]{8,64}$')
                    && request.resource.data.claimedAt == request.time
                    && (resource.data.get('claimedAt', null) == null
                        || resource.data.get('claimedBy', '') == request.resource.data.claimedBy
                        || resource.data.claimedAt + duration.value(2, 'm') <= request.time);
      // Processed only after the sender's local attendance data has been read back successfully.
      allow update: if owner()
                    && resource.data.status == 'answered'
                    && request.resource.data.status == 'processed'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt'])
                    && request.resource.data.processedAt == request.time;
      allow delete: if owner() && (resource.data.status in ['cancelled', 'processed']
                    || (resource.data.status == 'asking' && request.time >= resource.data.expiresAt));
    }


    // Product-link analytics omits class details, email, IP address, location and device/browser fingerprints.
    // Reads and retention deletion are limited to the verified developer account.
    match /productLinkEvents/{eventId} {
      function validShape() {
        return request.resource.data.keys().hasAll(['source', 'linkId', 'kind', 'ownerUid', 'fromName', 'recipientName', 'createdAt'])
          && request.resource.data.keys().hasOnly(['source', 'linkId', 'kind', 'ownerUid', 'fromName', 'recipientName', 'createdAt'])
          && request.resource.data.source in ['share-ping', 'mate-invite']
          && request.resource.data.linkId is string && request.resource.data.linkId.size() > 0 && request.resource.data.linkId.size() <= 128
          && request.resource.data.kind in ['created', 'opened', 'answered', 'used']
          && request.resource.data.ownerUid is string && request.resource.data.ownerUid.size() > 0 && request.resource.data.ownerUid.size() <= 128
          && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
          && request.resource.data.recipientName is string && request.resource.data.recipientName.size() <= 40
          && request.resource.data.createdAt == request.time;
      }

      function pingPath() {
        return /databases/$(database)/documents/sharePings/$(request.resource.data.linkId);
      }
      function invitePath() {
        return /databases/$(database)/documents/invites/$(request.resource.data.linkId);
      }

      function validPingEvent() {
        let ping = get(pingPath()).data;
        return ping.ownerUid == request.resource.data.ownerUid
          && ping.fromName == request.resource.data.fromName
          && ping.recipientName == request.resource.data.recipientName
          && ping.purgeAt is timestamp
          && request.time < ping.purgeAt
          && ((request.resource.data.kind == 'created'
                && eventId.matches('^sp-created-[a-f0-9]{64}$')
                && request.auth != null
                && request.auth.uid == ping.ownerUid
                && ping.status == 'asking')
            || (request.resource.data.kind == 'opened'
                && eventId.matches('^sp-open-[a-f0-9]{32}$')
                && ping.status in ['asking', 'answered', 'processed'])
            || (request.resource.data.kind == 'answered'
                && eventId.matches('^sp-answered-[a-f0-9]{64}$')
                && ping.status in ['answered', 'processed']));
      }

      function validInviteEvent() {
        let invite = get(invitePath()).data;
        return invite.owner == request.resource.data.ownerUid
          && invite.ownerName == request.resource.data.fromName
          && invite.expiresAt is timestamp
          && ((request.resource.data.kind == 'created'
                && eventId.matches('^mi-created-[A-Za-z0-9_-]{1,128}$')
                && request.auth != null
                && request.auth.uid == invite.owner)
            || (request.resource.data.kind == 'opened'
                && eventId.matches('^mi-open-[a-f0-9]{32}$')
                && request.auth != null
                && request.auth.uid != invite.owner
                && request.time < invite.expiresAt)
            || (request.resource.data.kind == 'used'
                && eventId.matches('^mi-used-[A-Za-z0-9_-]{1,128}$')
                && request.auth != null));
      }

      allow create: if validShape()
        && ((request.resource.data.source == 'share-ping'
              && exists(pingPath()) && validPingEvent())
            || (request.resource.data.source == 'mate-invite'
              && exists(invitePath()) && validInviteEvent()));
      allow get, list: if isDeveloper();
      allow delete: if isDeveloper()
        && resource.data.createdAt is timestamp
        && resource.data.createdAt < request.time - duration.value(90, 'd');
      allow update: if false;
    }

    // Push tokens: one device token per account, used only by the Cloud Functions (admin credentials)
    // to alert a mate about a ping. Private to the owner, so nobody else can read someone's token.
    match /pushTokens/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.token is string
                            && request.resource.data.token.size() > 0
                            && request.resource.data.token.size() < 4096;
    }

    // Synced data: one document per signed-in account, holding a full backup. Only that account can touch it.
    match /syncs/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rev == 1
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 900000;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rev == resource.data.rev + 1
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 900000;
    }

    // Feedback: anyone may create a bounded report, but only its signed-in author or the configured developer can read it.
    // The image is already compressed in the browser and capped below Firestore's 1 MiB document limit.
    match /feedback/{feedbackId} {
      function developer() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'adityavw2006@gmail.com';
      }
      function validFeedback() {
        return request.resource.data.keys().hasOnly(['uid', 'userEmail', 'userName', 'kind', 'rating', 'message', 'imageData', 'platform', 'deviceType', 'browser', 'area', 'frequency', 'network', 'status', 'seenByUser', 'createdAt'])
          && (request.resource.data.uid == null || (request.auth != null && request.resource.data.uid == request.auth.uid))
          && (request.resource.data.userEmail == null || (request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 320))
          && (request.resource.data.userName == null || (request.resource.data.userName is string && request.resource.data.userName.size() <= 100))
          && request.resource.data.kind in ['bug', 'rating', 'suggestion']
          && (request.resource.data.rating == null || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
          && request.resource.data.message is string && request.resource.data.message.size() <= 2000
          && (!('imageData' in request.resource.data) || (request.resource.data.imageData is string && request.resource.data.imageData.size() <= 380000))
          && (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 40))
          && (!('deviceType' in request.resource.data) || (request.resource.data.deviceType is string && request.resource.data.deviceType.size() <= 40))
          && (!('browser' in request.resource.data) || (request.resource.data.browser is string && request.resource.data.browser.size() <= 60))
          && (!('area' in request.resource.data) || (request.resource.data.area is string && request.resource.data.area.size() <= 80))
          && (!('frequency' in request.resource.data) || (request.resource.data.frequency is string && request.resource.data.frequency.size() <= 40))
          && (!('network' in request.resource.data) || (request.resource.data.network is string && request.resource.data.network.size() <= 40))
          && request.resource.data.status == 'open'
          && request.resource.data.seenByUser == false
          && request.resource.data.createdAt == request.time;
      }
      allow create: if validFeedback();
      allow get, list: if developer() || (request.auth != null && resource.data.uid != null && resource.data.uid == request.auth.uid);
      allow update: if developer()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['developerReply', 'status', 'repliedAt'])
                    && request.resource.data.developerReply is string
                    && request.resource.data.developerReply.size() <= 2000
                    && request.resource.data.status in ['replied', 'resolved']
                    && request.resource.data.repliedAt == request.time
                    || (request.auth != null
                    && resource.data.uid != null
                    && resource.data.uid == request.auth.uid
                    && resource.data.seenByUser == false
                    && request.resource.data.seenByUser == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByUser']));
      allow delete: if false;
    }

    // Block everything else by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
